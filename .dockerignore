# .gitignore - UPDATED VERSION

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
dist/
*.egg-info/

# Flask
instance/
.webassets-cache

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Environment
.env

# IMPORTANT: Only ignore temp data, NOT session files
data/temp/*
data/links/*
data/results/*

# KEEP linkedin sessions - they should be committed
# data/linkedin/  ← REMOVE THIS LINE IF IT EXISTS

# Keep folder structure
!data/.gitkeep
!data/temp/.gitkeep
!data/links/.gitkeep
!data/results/.gitkeep
!data/linkedin/.gitkeep
